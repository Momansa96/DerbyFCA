datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  passwordHash String
  status       String   @default("ACTIVE") // ACTIVE, REVOKED
  revokedAt    DateTime?
  revokedBy    String?  // ID de l'admin qui a révoqué
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([email])
}

model Player {
  id                String         @id @default(uuid())
  fullName          String
  alias             String?
  bureauRole        String?
  profilePhoto      String?
  preferredPosition String?
  description       String?
  number            Int?
  status            String         @default("ACTIF")
  joinDate          DateTime       @default(now())
  email             String?
  phone             String?
  teams             Team[]
  goals             Goal[]         @relation("GoalScorer")
  assists           Goal[]         @relation("GoalAssist")
  yellowCards       YellowCard[]
  redCards          RedCard[]
  contributions     Contribution[]
  friendlyCompositions FriendlyMatchPlayer[]
  friendlyGoals     FriendlyMatchGoal[] @relation("FMGoalScorer")
  friendlyAssists   FriendlyMatchGoal[] @relation("FMGoalAssist")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model Team {
  id           String   @id @default(uuid())
  name         String
  players      Player[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  team1Derbys  Derby[]  @relation("Team1Derbys")
  team2Derbys  Derby[]  @relation("Team2Derbys")
  team1Matches Match[]  @relation("Team1Matches")
  team2Matches Match[]  @relation("Team2Matches")
  goals        Goal[]
}

model Derby {
  id        String   @id @default(uuid())
  team1     Team     @relation("Team1Derbys", fields: [team1Id], references: [id])
  team1Id   String
  team2     Team     @relation("Team2Derbys", fields: [team2Id], references: [id])
  team2Id   String
  matches   Match[]
  status    String   @default("PENDING")
  winnerId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Match {
  id          String       @id @default(uuid())
  date        DateTime
  team1       Team         @relation("Team1Matches", fields: [team1Id], references: [id])
  team1Id     String
  team2       Team         @relation("Team2Matches", fields: [team2Id], references: [id])
  team2Id     String
  derby       Derby        @relation(fields: [derbyId], references: [id])
  derbyId     String
  score1      Int?
  score2      Int?
  status      String       @default("PENDING")
  winnerId    String?
  goals       Goal[]
  yellowCards YellowCard[]
  redCards    RedCard[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Goal {
  id             String   @id @default(uuid())
  match          Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId        String
  player         Player   @relation("GoalScorer", fields: [playerId], references: [id])
  playerId       String
  assistPlayer   Player?  @relation("GoalAssist", fields: [assistPlayerId], references: [id])
  assistPlayerId String?
  team           Team     @relation(fields: [teamId], references: [id])
  teamId         String
  isOwnGoal      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([matchId])
  @@index([playerId])
  @@index([assistPlayerId])
  @@index([teamId])
}

model FriendlyMatch {
  id            String   @id @default(uuid())
  type          String   // "officiel" | "amical" | "exhibition"
  date          String   // format : YYYY-MM-DD
  time          String   // format : HH:MM
  location      String   // exemple : Stade Gbegamey
  place         String   // "domicile" | "extérieur"
  opponent      String   // Nom de l'équipe adverse (= "Match interne" si isInternal)
  ourScore      Int?     // Score FCA / Équipe 1 (null tant que non joué)
  opponentScore Int?     // Score adversaire / Équipe 2
  status        String   @default("SCHEDULED") // SCHEDULED | COMPLETED
  notes         String?  // Commentaire libre
  isInternal    Boolean  @default(false) // true = exhibition interne entre joueurs FCA
  compositions  FriendlyMatchPlayer[]
  goals         FriendlyMatchGoal[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
}

model FriendlyMatchPlayer {
  id              String        @id @default(uuid())
  friendlyMatch   FriendlyMatch @relation(fields: [friendlyMatchId], references: [id], onDelete: Cascade)
  friendlyMatchId String
  player          Player        @relation(fields: [playerId], references: [id])
  playerId        String
  role            String        // "TITULAIRE" | "REMPLACANT"
  position        String?       // "GK" | "DEF" | "ATT_L" | "ATT_C" | "ATT_R" (null si REMPLACANT ou exhibition interne)
  side            String        @default("HOME") // "HOME" = FCA / Équipe 1, "AWAY" = Équipe 2 (interne uniquement)
  createdAt       DateTime      @default(now())

  @@unique([friendlyMatchId, playerId])
  @@index([friendlyMatchId])
  @@index([playerId])
}

model FriendlyMatchGoal {
  id              String        @id @default(uuid())
  friendlyMatch   FriendlyMatch @relation(fields: [friendlyMatchId], references: [id], onDelete: Cascade)
  friendlyMatchId String
  player          Player        @relation("FMGoalScorer", fields: [playerId], references: [id])
  playerId        String
  assistPlayer    Player?       @relation("FMGoalAssist", fields: [assistPlayerId], references: [id])
  assistPlayerId  String?
  minute          Int?
  side            String        @default("HOME") // "HOME" / "AWAY" — utile pour exhibition interne
  createdAt       DateTime      @default(now())

  @@index([friendlyMatchId])
  @@index([playerId])
  @@index([assistPlayerId])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String   // LOGIN_SUCCESS, LOGIN_FAILED, REGISTER_SUCCESS, etc.
  userId    String?  // ID de l'utilisateur (si applicable)
  email     String?  // Email utilisé pour la tentative
  ip        String?  // Adresse IP du client
  userAgent String?  // User-Agent du navigateur
  details   String?  // Détails supplémentaires (JSON)
  createdAt DateTime @default(now())

  @@index([action])
  @@index([userId])
  @@index([email])
  @@index([createdAt])
}

model MembershipApplication {
  id            String   @id @default(uuid())

  // Informations personnelles
  lastName      String
  firstName     String
  email         String
  whatsapp      String   // Numéro WhatsApp actif
  profession    String

  // Football
  motivation    String   @db.Text // Texte libre
  availability  String   // "AVAILABLE", "NOT_AVAILABLE", "SOMETIMES"

  // Consentement
  acceptedTerms Boolean  @default(false)
  acceptedAt    DateTime?

  // Suivi simple
  isViewed      Boolean  @default(false)  // Pour le badge "nouvelles"
  viewedAt      DateTime?
  viewedBy      String?  // ID de l'admin qui a consulté

  // Dates
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isViewed])
  @@index([createdAt])
  @@index([email])
}

model ContributionWeek {
  id            String         @id @default(uuid())
  year          Int            // Année (ex: 2025)
  weekNumber    Int            // Numéro de la semaine (1-52)
  weekStartDate DateTime       // Date de début de semaine (lundi)
  weekEndDate   DateTime       // Date de fin de semaine (dimanche)
  amount        Int            @default(200) // Montant attendu en FCFA
  contributions Contribution[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([year, weekNumber]) // Une seule semaine par numéro/année
  @@index([year])
  @@index([weekStartDate])
}

model Contribution {
  id          String           @id @default(uuid())
  player      Player           @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerId    String
  week        ContributionWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  weekId      String
  amountPaid  Int              // Montant payé (peut être différent de 200)
  paymentDate DateTime         @default(now()) // Date réelle du paiement
  notes       String?          // Notes (ex: "Payé en retard", "Avance 4 semaines")
  recordedBy  String?          // ID de l'admin qui a enregistré
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([playerId, weekId]) // Un joueur ne peut payer qu'une fois par semaine
  @@index([playerId])
  @@index([weekId])
  @@index([paymentDate])
}

model YellowCard {
  id        String   @id @default(uuid())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId   String
  player    Player   @relation(fields: [playerId], references: [id])
  playerId  String
  minute    Int?     // Minute du carton (optionnel)
  reason    String?  // Raison du carton (optionnel)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([matchId])
  @@index([playerId])
}

model RedCard {
  id        String   @id @default(uuid())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId   String
  player    Player   @relation(fields: [playerId], references: [id])
  playerId  String
  minute    Int?     // Minute du carton (optionnel)
  reason    String?  // Raison du carton (optionnel)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([matchId])
  @@index([playerId])
}
